# Required: XorKey is used for cryptographic signing (generate with: openssl rand -hex 32)
XOR_KEY=change_me_to_a_random_hex_string

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# Admin (set to auto-create admin user on first run)
ADMIN_PASSWORD=Admin@2022

# GZCTF
GZCTF_PORT=8080

# Container web domain (optional). When set, container IP:Port entries are displayed as {Port}.{Domain}
# e.g. VITE_CONTAINER_DOMAIN=mydomain.com → 1025.mydomain.com instead of 10.10.121.21:1025
VITE_CONTAINER_DOMAIN=
GZCTF_TITLE=GZ::CTF
GZCTF_SLOGAN=Hack for fun not for profit
GZCTF_ALLOW_REGISTER=true
GZCTF_ACTIVE_ON_REGISTER=true
